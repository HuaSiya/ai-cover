{
  "manifest_version": 2,
  "id": "github.husiya.ai-cover",
  "version": "1.3.1",
  "name": "AI 翻唱点歌",
  "description": "支持 /翻唱、/点歌 和 @机器人 翻唱XX/唱XX/点歌XX：在 B 站搜索 AI 翻唱或歌曲音频，自动选择并下载音频，通过 QQ 语音消息发送。包含候选打分、音频缓存、冷却与每日上限。",
  "author": {
    "name": "HuaSiya",
    "url": "https://github.com/HuaSiya"
  },
  "license": "MIT",
  "plugin_type": "media",
  "urls": {
    "repository": "https://github.com/HuaSiya/ai-cover",
    "homepage": "https://github.com/HuaSiya/ai-cover",
    "documentation": "https://github.com/HuaSiya/ai-cover/blob/main/README.md",
    "issues": "https://github.com/HuaSiya/ai-cover/issues"
  },
  "host_application": {
    "min_version": "1.3.18",
    "max_version": "1.4.99"
  },
  "sdk": {
    "min_version": "2.19.0",
    "max_version": "2.98.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.27.0"
    }
  ],
  "capabilities": [
    "send.text",
    "send.custom"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/icon.svg",
      "fallback": "music",
      "background": "#1C272C"
    }
  },
  "changelog": "CHANGELOG.md"
}
